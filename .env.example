# Vercel Blob — the portal's online storage (data + uploaded images).
# Auto-injected by Vercel when you connect a Blob store to the project
# (Vercel dashboard → Storage → Blob). You do NOT set this by hand in prod.
#
# Without it, the portal still works but saves to the current browser only.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx
